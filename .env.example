# Central LLM Configuration (REQUIRED - Google Gemini API)
# Do NOT use OpenAI. This project strictly relies on Google Gemini API via `google-genai`.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional & Future Service Integrations
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
DEEPGRAM_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-engineer-assessment
LANGSMITH_TRACING=false
COHERE_API_KEY=
ELEVENLABS_API_KEY=

# Knowledge Base Settings (Q2)
CHROMA_PERSIST_DIR=./q2_knowledge_base/data/chroma
HYBRID_RETRIEVAL_ALPHA=0.5
TOP_K_RETRIEVAL=5
